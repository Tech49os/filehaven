{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "文件管家",
  "version": "0.3.0-alpha.1",
  "identifier": "com.filebutler.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "文件管家",
        "width": 1280,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "本地智能文件归档客户端",
    "longDescription": "扫描散落各处的文件，AI 归纳分类，人工确认后安全迁移到统一归档目录。"
  }
}
